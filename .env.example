# ---- 运行环境（C4-3）----
# development（默认，本机开发）/ production（上线）。
# production 下若 JWT_SECRET 仍是示例值，应用会拒绝启动。
APP_ENV=development

# ---- 数据库 ----
DATABASE_URL=sqlite+aiosqlite:///./insightcrew.db

# ---- Redis（队列 + SSE 广播）----
# 本机开发用 localhost 即可。
# ★ 用 docker compose 部署时不要改这里：容器内的 localhost 是容器自己，
#   compose 已对 api / worker 显式覆盖为 redis://redis:6379/0。
REDIS_URL=redis://localhost:6379/0

# ---- 鉴权 ----
# ★ 上线前必须换成随机值（production 模式下仍为示例值会拒绝启动）：
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=change_me_to_random_64_chars
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# ---- 用户自定义模型（M2.5）----
# 用户 API Key 的加密主密钥（Fernet，44 字节 base64）。
# 生成: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 不设置时会从 JWT_SECRET 派生临时密钥（进程重启后旧密文解不开），生产必须配置。
FERNET_KEY=
# 内置 5 个模型（DeepSeek Flash/Pro + GLM-4V Flash/Plus + GPT-4o mini）的解锁密码。
# 所有用户（含站长）默认都锁着，各自输入该密码解锁后才能使用内置模型；
# 未解锁用户看不到内置模型，只能自己添加 API 来源（BYOK）。
BUILTIN_UNLOCK_PASSWORD=change_me_builtin_password
# 解锁有效期（小时）
BUILTIN_UNLOCK_TTL_HOURS=12

# ---- 模型厂商 ----
DEEPSEEK_API_KEY=your_deepseek_api_key
ZHIPU_API_KEY=your_zhipu_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://linoapi.com.cn/v1
# DASHSCOPE_API_KEY=              # 千问暂不启用

# ---- 运行参数 ----
WORKER_CONCURRENCY=3
MAX_PARALLEL_RESEARCHERS=3
TASK_BUDGET_LIMIT_CNY=5.0
LOG_LEVEL=INFO
# 允许跨域的来源，逗号分隔（C4-4）。留空 = 不挂 CORS（页面与 API 同源，无需跨域）。
# CORS_ORIGINS=https://your-frontend.example.com
# 是否信任 X-Forwarded-For / X-Real-IP（C4-1）。直连部署保持 0；
# 经 Nginx 反代时设 1，否则限流看到的 IP 全是 Nginx 容器地址。
TRUST_PROXY=0
# 接口限流开关（C4-1）。生产恒开、不受此项影响；本机跑验证脚本时设 0 避免互相误伤。
RATE_LIMIT_ENABLED=1

# ---- 模型模式 ----
# MOCK_LLM=1 使用本机 8001 端口的假模型服务（不花钱、不联网，仅开发调试用）
# MOCK_LLM=0 使用真实模型（默认；不设置本项即为 0）
# 设为 1 时必须同时启动: python -m src.tools.mock_llm_server
MOCK_LLM=0
